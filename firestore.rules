rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Traveller profiles: anyone signed in can read (community), only the
    // owner can write their own document.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 40;
      allow delete: if false;

      // Private trips and journal entries synced from the phone.
      match /trips/{tripId} {
        allow read, write: if isOwner(uid);
      }
      match /journal/{entryId} {
        allow read, write: if isOwner(uid);
      }
    }

    // One review per traveller per place; id = placeId_uid.
    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && reviewId == request.resource.data.placeId + '_' + request.auth.uid
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 20
        && request.resource.data.text.size() <= 500;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Aggregate counters updated alongside reviews / saves / visits.
    match /placeStats/{placeId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }
  }
}
